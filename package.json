{
  "name": "campusconnect",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:test": "tsx scripts/migrate.ts test",
    "e2e": "playwright test",
    "admin:create": "tsx scripts/create-platform-admin.ts",
    "storage:init": "tsx scripts/storage-init.ts",
    "storage:reconcile": "tsx scripts/storage-reconcile.ts",
    "db:normalize": "tsx scripts/normalize-identifiers.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1167.0",
    "@aws-sdk/s3-request-presigner": "^3.1167.0",
    "@node-rs/argon2": "^2.2.2",
    "csv-parse": "^7.0.3",
    "kysely": "^0.29.8",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "eslint": "^10",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}

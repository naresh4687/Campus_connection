# Copy to .env (git-ignored). These are local-development defaults only.
# NEVER put production credentials in this file.
# APP_DATABASE_URL (optional) takes precedence over DATABASE_URL; use it where a platform manages DATABASE_URL for you.
DATABASE_URL=postgresql://cc_app:dev_app_pw@127.0.0.1:5433/campusconnect_dev
MIGRATE_DATABASE_URL=postgresql://cc_owner:dev_owner_pw@127.0.0.1:5433/campusconnect_dev
TEST_DATABASE_URL=postgresql://cc_app:dev_app_pw@127.0.0.1:5433/campusconnect_test
TEST_MIGRATE_DATABASE_URL=postgresql://cc_owner:dev_owner_pw@127.0.0.1:5433/campusconnect_test

# --- Phase 1 auth settings ---
# Secret used to HMAC emails/IPs before they are stored in rate-limit/audit tables. >= 32 chars. Dev value only.
AUTH_PEPPER=dev-only-pepper-change-me-0123456789abcdef
# Cookie "Secure" flag. true in production (uses the __Host- cookie prefix); false only for plain-http local runs.
AUTH_COOKIE_SECURE=false
# Number of trusted reverse proxies in front of the app (0 = do not trust X-Forwarded-For; per-IP rate limits are then skipped, per-account limits still apply).
# In production behind one load balancer/proxy set this to 1 (see DEPLOYMENT.md).
TRUSTED_PROXY_HOPS=0

# --- Phase 2 ---
# Public origin used to build one-time invitation/reset links. Required in production.
APP_BASE_URL=http://localhost:3000

# --- Phase 6 private document storage (S3-compatible) ---
S3_ENDPOINT=http://127.0.0.1:9000
# Origin that BROWSERS can reach, used when signing download links. Defaults to S3_ENDPOINT. In production this is the provider's public endpoint.
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
# Cloudflare R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto, S3_FORCE_PATH_STYLE=true (see DEPLOYMENT.md section 3b).
S3_BUCKET=campusconnect-private-dev
S3_ACCESS_KEY=dev_storage_access
S3_SECRET_KEY=dev_storage_secret_key
S3_FORCE_PATH_STYLE=true

# --- AI-assisted drive creation (docs/AI_DRIVE_CREATION.md) ---
# The pattern-based reader (dates, salary, CGPA, arrears, departments...) needs no model and is always available.
# A language model is optional and OFF unless AI_EXTRACTION_ENABLED=true. Choose one provider:
#   local      a self-hosted small model behind an OpenAI-compatible endpoint (llama.cpp llama-server, Ollama, vLLM)
#   anthropic  the hosted API (needs ANTHROPIC_API_KEY)
# AI_EXTRACTION_ENABLED=true
# AI_PROVIDER=local
# AI_LOCAL_URL=http://127.0.0.1:8081
# AI_MODEL=qwen2.5-1.5b-instruct-q4_k_m
# AI_TIMEOUT_MS=90000
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# AI_API_BASE=https://api.anthropic.com

# --- Web Push (PUSH_NOTIFICATIONS.md) ---
# Off unless all three VAPID settings are valid. Generate a key pair once with:  npm run push:vapid
# The private key is a server secret: never commit it, never put it in a NEXT_PUBLIC_ variable.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@your-college.example
# Secret the scheduler sends as "Authorization: Bearer ..." to /api/push/dispatch (32+ random characters). Unset = that endpoint does not exist.
# PUSH_WORKER_SECRET=
# Only for `npm run push:worker` (a long-running worker instead of a scheduler): seconds between passes (default 10).
# PUSH_WORKER_INTERVAL_SECONDS=10
